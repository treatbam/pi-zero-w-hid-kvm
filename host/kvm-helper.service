# systemd --user unit for the host helper (runs as you, never root).
#   mkdir -p ~/.config/systemd/user && cp host/kvm-helper.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now kvm-helper
#   loginctl enable-linger $USER     # keep it running when you're logged out
# Edit ExecStart if the repo lives somewhere other than ~/pi-zero-w-hid-kvm.
[Unit]
Description=Pi Zero W HID KVM host helper (stats, still, serial shell mode)

[Service]
Environment=KVM_HOST_DEV=/dev/serial/by-id/usb-DIY_PiZeroW_HID_KVM_0001-if03
Environment=KVM_DISPLAY=:0
ExecStart=/usr/bin/python3 %h/pi-zero-w-hid-kvm/host/kvm_helper.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
